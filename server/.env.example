# HTTP
PORT=3333
# Origens liberadas no CORS (separe por vírgula)
WEB_URL=http://localhost:5173

# Banco (docker compose up -d)
DATABASE_URL=postgresql://docker:docker@localhost:5432/agents

# Gemini (obrigatório): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI (opcional): fallback quando o Gemini falha
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Transcrição: gemini (padrão) ou whisper (local, exige Python + openai-whisper + ffmpeg)
# TRANSCRIPTION_PROVIDER=gemini
# PYTHON_BIN=python
# WHISPER_MODEL=base
