{
  "name": "nlw-agents-server",
  "version": "2.0.0",
  "private": true,
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "db:generate": "node --import tsx ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "node --import tsx ./node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:reindex": "tsx src/scripts/reindex-embeddings.ts",
    "list-models": "tsx src/scripts/list-models.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.0.1",
    "@fastify/multipart": "9.0.3",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^5.2.6",
    "@google/genai": "^1.27.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.44.2",
    "fastify": "5.4.0",
    "fastify-type-provider-zod": "5.0.1",
    "openai": "^6.9.1",
    "postgres": "3.4.7",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.5",
    "@types/node": "^24.0.8",
    "drizzle-kit": "0.31.4",
    "drizzle-seed": "0.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "ultracite": "5.0.27"
  }
}
